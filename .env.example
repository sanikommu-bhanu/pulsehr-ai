# ---- Firebase (get these from Firebase Console > Project Settings > General) ----
# Enable Email/Password + Google in Authentication, and create a Firestore
# database + a default Storage bucket for these to actually take effect.
# Leaving these blank runs the app in local mode: real per-account
# authentication and a real multi-tenant company/employee data model,
# backed by localStorage + cross-tab BroadcastChannel sync instead of
# Firestore. Nothing is seeded — every account and record is created by
# using the app. See README.md "Run modes".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- AI (Google Gemini) ----
# Used by the AI HR Assistant, Helpdesk pre-chat, and every generated
# insight (leave recommendations, policy search, performance summaries,
# attendance insights, weekly HR reports, burnout indicators).
# Get a free key at https://aistudio.google.com/app/apikey
#
# NOTE: This demo calls the Gemini API directly from the browser for
# hackathon simplicity, which exposes the key to anyone who opens devtools.
# For a production deployment, move the call in src/lib/aiAssistant.js
# behind a small serverless function (Firebase Cloud Function / Vercel /
# Cloudflare Worker) and keep the key server-side.
VITE_GEMINI_API_KEY=
